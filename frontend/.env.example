# Frontend requests use this base URL. Keep secrets out of VITE_* variables.
VITE_API_BASE_URL=/api

# Set this after the backend team confirms the local server address/port.
# VITE_API_PROXY_TARGET=http://localhost:<backend-port>

# Optional local-only mock session for page previews (admin, wil_handler, mentor, intern).
# This value is honored only by the Vite development server.
# VITE_DEV_AUTH_ROLE=admin
