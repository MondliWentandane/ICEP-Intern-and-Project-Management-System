# Local frontend authentication mode. Mock login is honored only by the Vite development server.
# In production, login always uses the backend API.
VITE_AUTH_MODE=mock

# Frontend API base URL; no live backend is contacted unless a backend/proxy is configured.
VITE_API_BASE_URL=/api

# Set this after the backend team confirms the local server address/port.
# VITE_API_PROXY_TARGET=http://localhost:<backend-port>

# Demo login accounts (development only); all use password ICEPdemo1!:
# admin@icep.local
# handler@icep.local
# mentor@icep.local
# intern@icep.local
